FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1


RUN apt-get update && apt-get install -y \
    gcc \
    libmariadb-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app

EXPOSE 27720

# CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "27720", "--ssl-certfile", "/etc/letsencrypt/live/beckers.systems/fullchain.pem", "--ssl-keyfile", "/etc/letsencrypt/live/beckers.systems/privkey.pem"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "27720"]